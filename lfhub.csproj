<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LFHub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.5.0</Version>

    <!-- `dotnet publish /t:PublishContainer` builds the OCI image without Docker. -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <!-- Links the image to the repository that built it (RepositoryUrl, set by the workflow). -->
    <ContainerLabel Include="org.opencontainers.image.source" Value="$(RepositoryUrl)" Condition="'$(RepositoryUrl)' != ''" />
    <!-- The image tag the hub is published under (HubChannel, set by the workflow), reported in /v1/me. -->
    <AssemblyMetadata Include="Channel" Value="$(HubChannel)" Condition="'$(HubChannel)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" Version="3.3.7" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <InternalsVisibleTo Include="LFHub.Tests" />
  </ItemGroup>

</Project>
